# Shopify App Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=read_orders,write_orders,read_products,write_products,read_customers
SHOPIFY_APP_URL=https://your-app-domain.up.railway.app

# Database Configuration (Multi-tenant PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/byndcart?schema=public"

# Security & Encryption (Persists courier API credentials)
ENCRYPTION_SECRET="your_32_byte_random_encryption_secret_key!"

# Notifications Engine (Resend Email API)
RESEND_API_KEY=re_123456789_your_resend_api_key

